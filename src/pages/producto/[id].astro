---
// src/pages/producto/[id].astro - Plantilla dinámica de Astro para los 20 Productos
// Astro generará automáticamente una página única para cada ID de producto en build-time.
import '../../styles/global.css';
import { products } from '../../data/products';

// Define qué páginas deben generarse
export async function getStaticPaths() {
  return products.map((prod) => ({
    params: { id: prod.id },
    props: { prod }
  }));
}

const { prod } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Análisis: {prod.title} | ElegidosParaTi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">

  <!-- HEADER -->
  <header class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-extrabold text-violet-600">💎 ElegidosParaTi</a>
      <a href="/" class="text-sm font-semibold text-slate-600 hover:text-violet-600">← Volver al Inicio</a>
    </div>
  </header>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12">
        
        <!-- Columna Izquierda: Imagen y Ficha -->
        <div class="lg:col-span-5 space-y-6">
          <img src={prod.image} alt={prod.title} class="w-full h-80 object-cover rounded-2xl border border-slate-100" />
          
          <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200">
            <h4 class="font-bold text-sm text-slate-800 uppercase tracking-wider mb-3">Especificaciones</h4>
            <div class="divide-y divide-slate-200">
              {Object.entries(prod.specs).map(([key, val]) => (
                <div class="flex justify-between py-2 text-sm">
                  <span class="font-semibold text-slate-500">{key}</span>
                  <span class="text-slate-800">{val}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Análisis y Enlaces -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <span class="text-xs font-extrabold text-violet-700 uppercase tracking-wider">{prod.categoryLabel}</span>
            <h1 class="text-3xl font-extrabold text-slate-900 mt-2 mb-3">{prod.title}</h1>
            
            <div class="flex items-center gap-1.5 text-sm text-slate-500 mb-6">
              <span>⭐ {prod.rating}</span>
              <span>({prod.reviewsCount} opiniones reales en Amazon)</span>
            </div>

            <p class="text-slate-700 leading-relaxed font-semibold mb-4">{prod.description}</p>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">{prod.longDescription}</p>

            <!-- Pros y Contras -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="bg-green-50 border border-green-100 rounded-2xl p-4">
                <span class="font-bold text-green-900 text-sm block mb-2">✔️ Pros</span>
                <ul class="space-y-1 text-xs text-slate-700 list-disc list-inside">
                  {prod.pros.map(pro => <li>{pro}</li>)}
                </ul>
              </div>

              <div class="bg-rose-50 border border-rose-100 rounded-2xl p-4">
                <span class="font-bold text-rose-900 text-sm block mb-2">❌ Contras</span>
                <ul class="space-y-1 text-xs text-slate-700 list-disc list-inside">
                  {prod.cons.map(con => <li>{con}</li>)}
                </ul>
              </div>
            </div>
          </div>

          <!-- Caja de Compra con Afiliación -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
            <div>
              <span class="text-xs text-slate-400 block font-bold uppercase">Categoría Presupuesto</span>
              <span class="text-xl font-extrabold text-slate-900">{prod.priceLabel} ({prod.priceRange})</span>
            </div>
            <a 
              href={prod.amazonUrl} 
              target="_blank" 
              rel="noopener noreferrer nofollow" 
              class="w-full sm:w-auto text-center bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-extrabold px-6 py-3 rounded-xl transition-all shadow text-sm"
            >
              Comprar en Amazon ➔
            </a>
          </div>

        </div>
      </div>
    </div>
  </main>
</body>
</html>
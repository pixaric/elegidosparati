---
import '../styles/global.css';
import { products, buyingGuides } from '../data/products';

// Filtrados estáticos iniciales
const editorChoices = products.filter(p => p.isEditorChoice);

const siteTitle = "ElegidosParaTi | Tu Guía de Compra Inteligente en Amazon";
const siteDescription = "Analizamos, comparamos y filtramos los mejores productos de Amazon para ahorrarte tiempo y dinero con herramientas inteligentes.";

// Definición de las 8 categorías del portal
const categories = [
  { name: "Audio & Sonido", icon: "🎧", count: "5 Selecciones", slug: "audio" },
  { name: "Gaming & Streaming", icon: "🎮", count: "5 Selecciones", slug: "gaming" },
  { name: "Oficina & Trabajo", icon: "⌨️", count: "5 Selecciones", slug: "productividad" },
  { name: "Hogar Inteligente", icon: "🏠", count: "3 Selecciones", slug: "smarthome" },
  { name: "Deporte & Fitness", icon: "🏃‍♂️", count: "3 Selecciones", slug: "deportes" },
  { name: "Cocina & Hogar", icon: "🍳", count: "3 Selecciones", slug: "cocina" },
  { name: "Fotografía & Vídeo", icon: "📷", count: "3 Selecciones", slug: "fotografia" },
  { name: "Cuidado Personal", icon: "🪒", count: "3 Selecciones", slug: "belleza" },
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content={siteDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">

  <!-- HEADER -->
  <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl group-hover:scale-110 transition-transform">💎</span>
        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-violet-600 to-emerald-500 bg-clip-text text-transparent">ElegidosParaTi</span>
      </a>
      
      <nav class="hidden lg:flex items-center gap-6">
        <a href="/" class="text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-violet-600 transition-colors">Inicio</a>
        <span class="text-slate-300">|</span>
        <a href="#guias" class="text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-violet-600 transition-colors">Guías Destacadas</a>
      </nav>

      <div>
        <button id="ai-recommender-btn" class="bg-violet-600 hover:bg-violet-700 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-md flex items-center gap-2">
          Sugerir Compra 🤖
        </button>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <main class="flex-grow">
    <section class="relative overflow-hidden py-16 lg:py-24 bg-gradient-to-b from-violet-50/50 via-white to-transparent">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-100 text-violet-700 text-xs font-semibold mb-6">
          <span>✨</span> Buscador, Asistente IA y Comparador con 8 Categorías Incorporadas
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 max-w-4xl mx-auto leading-tight">
          La compra inteligente en Amazon empieza <span class="bg-gradient-to-r from-violet-600 to-emerald-500 bg-clip-text text-transparent">aquí mismo</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto">
          Evita leer miles de reseñas dudosas. Utiliza nuestro buscador instantáneo, compara características a tu medida o deja que nuestro recomendador elija por ti.
        </p>

        <!-- BUSCADOR CENTRAL INTERACTIVO -->
        <div class="mt-10 max-w-xl mx-auto relative px-4">
          <div class="flex items-center bg-white border border-slate-200 rounded-2xl shadow-xl p-1.5 focus-within:border-violet-500 transition-all">
            <span class="pl-4 text-slate-400 text-lg">🔍</span>
            <input 
              id="search-input" 
              type="text" 
              placeholder={`Escribe para buscar entre los ${products.length} productos estrella...`} 
              class="w-full pl-3 pr-4 py-3 bg-transparent text-slate-800 placeholder-slate-400 focus:outline-none text-sm font-semibold"
            />
            <button id="clear-search-btn" class="hidden text-slate-400 hover:text-slate-600 mr-2 text-xs font-bold uppercase tracking-wider">Limpiar</button>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPLORAR 8 CATEGORÍAS -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span>📂</span> Acceso Rápido por Categorías (8 Secciones)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        {categories.map((cat) => (
          <a href={`/categoria/${cat.slug}`} class="group bg-white border border-slate-200 p-4 rounded-2xl hover:border-violet-300 hover:shadow-md transition-all flex flex-col items-center text-center justify-between">
            <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">{cat.icon}</span>
            <span class="font-bold text-xs text-slate-800 group-hover:text-violet-600 line-clamp-2 leading-tight">{cat.name}</span>
            <span class="text-[10px] text-slate-400 mt-1 block">{cat.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA: TODOS LOS PRODUCTOS -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" id="todos-los-productos">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <span>💎</span> Nuestro Catálogo Filtrable ({products.length} Selecciones)
          </h2>
          <p class="text-slate-500 mt-1 text-sm">Usa el buscador superior para filtrar de inmediato o marca casillas para comparar cara a cara.</p>
        </div>
      </div>

      <!-- Alerta No Coincidencias -->
      <div id="no-results" class="hidden bg-slate-100 border border-slate-200 p-8 rounded-2xl text-center">
        <span class="text-4xl">🔍</span>
        <h3 class="font-bold text-lg text-slate-800 mt-3">No hemos encontrado productos</h3>
        <p class="text-slate-500 text-sm mt-1">Prueba a escribir términos como 'auriculares', 'Cosori', 'Garmin', 'Razer' o 'Echo'.</p>
      </div>

      <!-- Contenedor de Tarjetas de Productos -->
      <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((prod) => (
          <div 
            class="product-card bg-white border border-slate-200 rounded-3xl overflow-hidden hover:shadow-lg transition-all flex flex-col justify-between"
            data-id={prod.id}
            data-title={prod.title.toLowerCase()}
            data-description={prod.description.toLowerCase()}
            data-category={prod.category}
          >
            <div>
              <div class="relative">
                <img src={prod.image} alt={prod.title} class="w-full h-52 object-cover" />
                {prod.isEditorChoice && (
                  <span class="absolute top-4 left-4 bg-violet-600 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-full shadow-md">
                    👑 Recomendado
                  </span>
                )}
                {prod.isBestValue && (
                  <span class="absolute top-4 left-4 bg-emerald-600 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-full shadow-md">
                    💰 Calidad/Precio
                  </span>
                )}
              </div>
              
              <div class="p-6">
                <span class="text-xs font-bold text-violet-600 uppercase tracking-wide">{prod.categoryLabel}</span>
                <h3 class="font-bold text-base text-slate-900 mt-1 line-clamp-1">{prod.title}</h3>
                
                <div class="flex items-center gap-1 text-xs text-slate-500 my-2">
                  <span>⭐ {prod.rating}</span>
                  <span>({prod.reviewsCount} opiniones)</span>
                </div>
                
                <p class="text-slate-600 text-xs line-clamp-3 leading-relaxed">{prod.description}</p>
                
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-500">Rango: {prod.priceRange} ({prod.priceLabel})</span>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 mt-2 flex flex-col gap-3">
              <!-- Check de Comparación -->
              <label class="flex items-center gap-2 cursor-pointer select-none bg-slate-50 hover:bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl transition-all">
                <input 
                  type="checkbox" 
                  class="compare-checkbox w-4 h-4 text-violet-600 border-slate-300 rounded focus:ring-violet-500" 
                  data-id={prod.id} 
                  data-title={prod.title}
                  data-rating={prod.rating}
                  data-price={prod.priceLabel}
                  data-image={prod.image}
                  data-pros={JSON.stringify(prod.pros)}
                  data-cons={JSON.stringify(prod.cons)}
                />
                <span class="text-xs font-semibold text-slate-700">Agregar al Comparador</span>
              </label>

              <div class="flex items-center justify-between gap-2">
                <a href={`/producto/${prod.id}`} class="text-xs font-bold text-slate-700 hover:text-violet-600 transition-colors">Análisis Completo →</a>
                <a href={prod.amazonUrl} target="_blank" rel="noopener noreferrer nofollow" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold px-4 py-2 rounded-xl text-xs flex items-center gap-1 shadow">
                  Comprar en Amazon 🛒
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ELECCIÓN DEL EDITOR -->
    <section class="bg-white border-y border-slate-200 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12">
          <h2 class="text-3xl font-extrabold text-slate-900">Recomendaciones Estrella 🏆</h2>
          <p class="mt-2 text-slate-600">Analizados exhaustivamente y garantizados como la mejor inversión de su segmento.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {editorChoices.slice(0, 6).map((prod) => (
            <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden hover:shadow-lg transition-all flex flex-col justify-between">
              <div>
                <img src={prod.image} alt={prod.title} class="w-full h-52 object-cover" />
                <div class="p-6">
                  <span class="text-xs font-bold text-violet-600 uppercase tracking-wide">{prod.categoryLabel}</span>
                  <h3 class="font-bold text-lg text-slate-900 mt-1 line-clamp-1">{prod.title}</h3>
                  <div class="flex items-center gap-1.5 text-xs text-slate-500 my-2">
                    <span>⭐ {prod.rating}</span>
                    <span>({prod.reviewsCount} opiniones)</span>
                  </div>
                  <p class="text-slate-600 text-sm line-clamp-3">{prod.description}</p>
                </div>
              </div>
              <div class="p-6 pt-0 mt-4 flex items-center justify-between gap-2 border-t border-slate-100">
                <a href={`/producto/${prod.id}`} class="text-xs font-bold text-slate-700 hover:text-violet-600 transition-colors">Análisis Completo →</a>
                <a href={prod.amazonUrl} target="_blank" rel="noopener noreferrer nofollow" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1 shadow">
                  Comprar en Amazon 🛒
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GUÍAS RECIENTES -->
    <section id="guias" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900">Guías de Compra Destacadas 📖</h2>
        <p class="mt-2 text-slate-600">Aprende qué buscar antes de soltar un solo euro.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {buyingGuides.map((guide) => (
          <article class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <img src={guide.image} alt={guide.title} class="w-full h-52 object-cover" />
              <div class="p-6">
                <span class="text-xs font-bold text-violet-600 uppercase tracking-wider">{guide.category}</span>
                <h3 class="font-bold text-xl text-slate-900 mt-2 mb-3">{guide.title}</h3>
                <p class="text-slate-600 text-sm line-clamp-3">{guide.summary}</p>
              </div>
            </div>
            <div class="p-6 pt-0 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 mt-4">
              <span>{guide.readTime}</span>
              <span class="font-bold text-violet-600">Guía Práctica</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <!-- PANEL DE COMPARATIVA FLOTANTE -->
  <div id="compare-tray" class="fixed bottom-6 right-6 z-50 transform translate-y-32 opacity-0 transition-all duration-300 max-w-sm w-full bg-slate-900 text-white p-5 rounded-3xl shadow-2xl border border-slate-800">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚖️</span>
        <h4 class="font-bold text-sm">Comparador (<span id="compare-count">0</span>/3)</h4>
      </div>
      <button id="close-tray-btn" class="text-slate-400 hover:text-white text-xs font-bold uppercase">Cerrar</button>
    </div>
    <div id="compare-tray-items" class="flex items-center gap-2 mb-4 overflow-x-auto py-1">
      <!-- Elementos agregados dinámicamente -->
    </div>
    <div class="flex gap-2">
      <button id="trigger-compare-modal-btn" class="w-full text-center bg-violet-600 hover:bg-violet-700 text-white font-bold py-2.5 rounded-xl text-xs transition-all shadow-md">
        Comparar Cara a Cara ➔
      </button>
    </div>
  </div>

  <!-- MODAL DE COMPARATIVA MÁXIMA -->
  <div id="compare-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-5xl w-full max-h-[90vh] overflow-y-auto p-6 md:p-8 shadow-2xl relative">
      <button id="close-compare-modal-btn" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
      <h3 class="font-extrabold text-2xl text-slate-900 mb-6 flex items-center gap-2">
        <span>⚖️</span> Comparación Detallada de Modelos
      </h3>
      <div class="overflow-x-auto">
        <div id="compare-matrix" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Columnas dinámicas de los productos -->
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL DE RECOMENDADOR POR IA (SUGERIR COMPRA) -->
  <div id="ai-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-xl w-full p-6 md:p-8 shadow-2xl relative">
      <button id="close-ai-modal-btn" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
      
      <!-- Paso 1: Introducción y Categoría -->
      <div id="ai-step-1" class="ai-step">
        <div class="text-center mb-4">
          <span class="text-4xl">🤖</span>
          <h3 class="font-extrabold text-xl text-slate-900 mt-2">Asistente de Compra Inteligente</h3>
          <p class="text-slate-500 text-sm mt-1 font-semibold">Te sugerimos el artículo perfecto de nuestras 8 categorías.</p>
        </div>
        <div class="space-y-3">
          <label class="block font-bold text-xs text-slate-800 uppercase tracking-wider">¿Qué tipo de producto buscas renovar hoy?</label>
          <div class="grid grid-cols-2 gap-2 max-h-64 overflow-y-auto pr-1">
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="audio">
              <span class="text-xl mb-1">🎧</span>
              <span class="text-[11px] font-bold text-slate-700">Audio & Sonido</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="gaming">
              <span class="text-xl mb-1">🎮</span>
              <span class="text-[11px] font-bold text-slate-700">Gaming</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="productividad">
              <span class="text-xl mb-1">⌨️</span>
              <span class="text-[11px] font-bold text-slate-700">Oficina & Trabajo</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="smarthome">
              <span class="text-xl mb-1">🏠</span>
              <span class="text-[11px] font-bold text-slate-700">Smart Home</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="deportes">
              <span class="text-xl mb-1">🏃‍♂️</span>
              <span class="text-[11px] font-bold text-slate-700">Deporte & Fitness</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="cocina">
              <span class="text-xl mb-1">🍳</span>
              <span class="text-[11px] font-bold text-slate-700">Cocina & Hogar</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="fotografia">
              <span class="text-xl mb-1">📷</span>
              <span class="text-[11px] font-bold text-slate-700">Fotografía & Vídeo</span>
            </button>
            <button class="ai-cat-btn border-2 border-slate-200 hover:border-violet-400 p-3 rounded-2xl flex flex-col items-center text-center transition-all" data-value="belleza">
              <span class="text-xl mb-1">🪒</span>
              <span class="text-[11px] font-bold text-slate-700">Cuidado Personal</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Paso 2: Presupuesto -->
      <div id="ai-step-2" class="ai-step hidden">
        <h4 class="font-extrabold text-lg text-slate-900 mb-4 flex items-center gap-2">
          <span>💰</span> ¿Cuánto tienes pensado invertir en tu compra?
        </h4>
        <div class="space-y-3">
          <button class="ai-budget-btn w-full border-2 border-slate-200 hover:border-violet-400 p-4 rounded-2xl flex justify-between items-center transition-all" data-value="€">
            <div class="text-left">
              <span class="font-bold text-sm text-slate-800 block">Presupuesto Económico</span>
              <span class="text-xs text-slate-500">Busco utilidad, simplicidad y ahorrar.</span>
            </div>
            <span class="font-extrabold text-emerald-600">€</span>
          </button>
          <button class="ai-budget-btn w-full border-2 border-slate-200 hover:border-violet-400 p-4 rounded-2xl flex justify-between items-center transition-all" data-value="€€">
            <div class="text-left">
              <span class="font-bold text-sm text-slate-800 block">Presupuesto Equilibrado</span>
              <span class="text-xs text-slate-500">Busco la mejor relación calidad-precio.</span>
            </div>
            <span class="font-extrabold text-amber-600">€€</span>
          </button>
          <button class="ai-budget-btn w-full border-2 border-slate-200 hover:border-violet-400 p-4 rounded-2xl flex justify-between items-center transition-all" data-value="€€€">
            <div class="text-left">
              <span class="font-bold text-sm text-slate-800 block">Presupuesto Premium</span>
              <span class="text-xs text-slate-500">Busco lo mejor del nicho, sin reparar en gastos.</span>
            </div>
            <span class="font-extrabold text-rose-600">€€€</span>
          </button>
        </div>
        <button id="ai-back-1-btn" class="mt-6 text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1">
          ← Volver atrás
        </button>
      </div>

      <!-- Paso 3: Resultado de la Recomendación -->
      <div id="ai-step-result" class="ai-step hidden">
        <div class="text-center mb-6">
          <span class="inline-block bg-green-100 text-green-700 p-2.5 rounded-full text-xs font-bold">✨ ¡Elección Ideal Encontrada!</span>
        </div>
        <div id="ai-result-content" class="bg-slate-50 rounded-2xl border border-slate-200 p-5 flex flex-col md:flex-row gap-4 items-center">
          <!-- Generado dinámicamente por JS -->
        </div>
        <div class="mt-6 flex flex-col gap-3">
          <a id="ai-amazon-link" href="#" target="_blank" rel="noopener noreferrer nofollow" class="w-full text-center bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold py-3.5 rounded-2xl transition-all shadow-md text-sm">
            Comprar ahora en Amazon 🛒
          </a>
          <a id="ai-review-link" href="#" class="w-full text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 rounded-2xl text-xs transition-all border border-slate-200">
            Leer Análisis de ElegidosParaTi →
          </a>
        </div>
        <button id="ai-reset-btn" class="mt-4 w-full text-center text-xs font-semibold text-slate-400 hover:text-slate-600">
          Volver a empezar test
        </button>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800/80 mb-6">
        <p class="text-xs text-slate-400/90 leading-relaxed">
          <strong>Aviso de Afiliación de Amazon:</strong> En calidad de Afiliado de Amazon, este portal obtiene ingresos por las compras adscritas que cumplen los requisitos aplicables. Al comprar desde nuestros enlaces, apoyas el sostenimiento de nuestras pruebas independientes sin coste adicional para ti.
        </p>
      </div>
      <div class="text-center text-xs">
        &copy; {new Date().getFullYear()} ElegidosParaTi. Todos los derechos reservados.
      </div>
    </div>
  </footer>

  <!-- SCRIPT DE CLIENTE INTERACTIVO PARA BUSCADOR, COMPARADOR E IA -->
  <script is:inline define:vars={{ products }}>
    // ==================== 1. MOTOR DE BUSCADOR ====================
    const searchInput = document.getElementById('search-input');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const productsGrid = document.getElementById('products-grid');
    const noResults = document.getElementById('no-results');
    const productCards = document.querySelectorAll('.product-card');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        if (query.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }

        productCards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-description') || '';

          if (title.includes(query) || desc.includes(query)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          productsGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          productsGrid.classList.remove('hidden');
        }
      });

      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        productCards.forEach(card => card.classList.remove('hidden'));
        noResults.classList.add('hidden');
        productsGrid.classList.remove('hidden');
        searchInput.focus();
      });
    }

    // ==================== 2. COMPARADOR DEFINITIVO (UNIFICADO) ====================
    let compareList = [];

    const compareTray = document.getElementById("compare-tray");
    const compareCount = document.getElementById("compare-count");
    const compareTrayItems = document.getElementById("compare-tray-items");
    const triggerCompareModalBtn = document.getElementById("trigger-compare-modal-btn");
    const closeTrayBtn = document.getElementById("close-tray-btn");
    const compareModal = document.getElementById("compare-modal");
    const closeCompareModalBtn = document.getElementById("close-compare-modal-btn");
    const compareMatrix = document.getElementById("compare-matrix");

    document.querySelectorAll(".compare-checkbox").forEach(chk => {
      chk.addEventListener("change", () => {
        const id = chk.dataset.id;

        if (chk.checked) {
          if (compareList.length >= 3) {
            alert("Solo puedes comparar hasta 3 productos.");
            chk.checked = false;
            return;
          }

          compareList.push({
            id,
            title: chk.dataset.title,
            image: chk.dataset.image,
            price: chk.dataset.price,
            rating: chk.dataset.rating,
            pros: JSON.parse(chk.dataset.pros),
            cons: JSON.parse(chk.dataset.cons),
          });

        } else {
          compareList = compareList.filter(p => p.id !== id);
        }

        renderCompareTray();
      });
    });

    function renderCompareTray() {
      compareTrayItems.innerHTML = "";
      compareCount.textContent = compareList.length;

      if (compareList.length === 0) {
        compareTray.classList.add("translate-y-32", "opacity-0");
        return;
      }

      compareTray.classList.remove("translate-y-32", "opacity-0");

      compareList.forEach(item => {
        const el = document.createElement("div");
        el.className = "relative flex-shrink-0 w-12 h-12 bg-white rounded-xl overflow-hidden border border-slate-700";

        el.innerHTML = `
          <img src="${item.image}" class="w-full h-full object-cover" />
          <button class="absolute -top-1 -right-1 bg-rose-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-[8px] font-bold"
            onclick="removeCompareItem('${item.id}')">&times;</button>
        `;

        compareTrayItems.appendChild(el);
      });
    }

    window.removeCompareItem = function(id) {
      compareList = compareList.filter(p => p.id !== id);
      const chk = document.querySelector(`.compare-checkbox[data-id="${id}"]`);
      if (chk) chk.checked = false;
      renderCompareTray();
    };

    triggerCompareModalBtn.addEventListener("click", () => {
      if (compareList.length < 2) {
        alert("Selecciona al menos 2 productos para comparar.");
        return;
      }

      renderCompareMatrix();
      compareModal.classList.remove("hidden");
    });

    closeCompareModalBtn.addEventListener("click", () => {
      compareModal.classList.add("hidden");
    });

    closeTrayBtn.addEventListener('click', () => {
      compareTray.classList.add('translate-y-32', 'opacity-0');
    });

    function renderCompareMatrix() {
      compareMatrix.innerHTML = "";

      compareList.forEach(item => {
        const col = document.createElement("div");
        col.className = "bg-slate-50 border border-slate-200 p-5 rounded-2xl";

        col.innerHTML = `
          <img src="${item.image}" class="w-full h-36 object-cover rounded-xl mb-4" />
          <h4 class="font-bold text-base text-slate-800 mb-1">${item.title}</h4>
          <p class="text-xs text-slate-500 mb-3">⭐ ${item.rating}</p>

          <div class="border-t border-slate-200 pt-3 mt-3">
            <span class="text-xs font-bold text-slate-400 uppercase block mb-1">Precio</span>
            <span class="text-sm font-bold text-slate-800">${item.price}</span>
          </div>

          <div class="border-t border-slate-200 pt-3 mt-3">
            <span class="text-xs font-bold text-emerald-600 uppercase block mb-2">✔️ Pros</span>
            <ul class="space-y-1.5">
              ${item.pros.map(p => `<li class="text-xs text-slate-600">✔️ ${p}</li>`).join("")}
            </ul>
          </div>

          <div class="border-t border-slate-200 pt-3 mt-3">
            <span class="text-xs font-bold text-rose-600 uppercase block mb-2">❌ Contras</span>
            <ul class="space-y-1.5">
              ${item.cons.map(c => `<li class="text-xs text-slate-600">❌ ${c}</li>`).join("")}
            </ul>
          </div>

          <div class="mt-6">
            <a href="/producto/${item.id}" class="text-xs font-bold text-violet-600 hover:underline">Ver análisis detallado</a>
          </div>
        `;

        compareMatrix.appendChild(col);
      });
    }

    // ==================== 3. RECOMENDADOR IA DEFINITIVO ====================
    let aiCategory = "";
    let aiBudget = "";

    const aiModal = document.getElementById("ai-modal");
    const aiRecommenderBtn = document.getElementById("ai-recommender-btn");
    const closeAiModalBtn = document.getElementById("close-ai-modal-btn");

    const aiStep1 = document.getElementById("ai-step-1");
    const aiStep2 = document.getElementById("ai-step-2");
    const aiStepResult = document.getElementById("ai-step-result");

    const aiResultContent = document.getElementById("ai-result-content");
    const aiAmazonLink = document.getElementById("ai-amazon-link");
    const aiReviewLink = document.getElementById("ai-review-link");

    const aiBack1Btn = document.getElementById("ai-back-1-btn");
    const aiResetBtn = document.getElementById("ai-reset-btn");

    aiRecommenderBtn.addEventListener("click", () => {
      aiModal.classList.remove("hidden");
      resetAiWizard();
    });

    closeAiModalBtn.addEventListener("click", () => {
      aiModal.classList.add("hidden");
    });

    document.querySelectorAll(".ai-cat-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        aiCategory = btn.dataset.value;
        aiStep1.classList.add("hidden");
        aiStep2.classList.remove("hidden");
      });
    });

    document.querySelectorAll(".ai-budget-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        aiBudget = btn.dataset.value;
        generateAiRecommendation();
      });
    });

    aiBack1Btn.addEventListener("click", () => {
      aiStep2.classList.add("hidden");
      aiStep1.classList.remove("hidden");
    });

    aiResetBtn.addEventListener("click", resetAiWizard);

    function resetAiWizard() {
      aiCategory = "";
      aiBudget = "";
      aiStep1.classList.remove("hidden");
      aiStep2.classList.add("hidden");
      aiStepResult.classList.add("hidden");
    }

    function generateAiRecommendation() {
      let filtered = products.filter(p => p.category === aiCategory);

      let chosen;

      if (aiBudget === "€") {
        chosen = filtered.find(p => p.priceLabel === "Económico");
      } else if (aiBudget === "€€") {
        chosen = filtered.find(p => p.priceLabel === "Calidad/Precio");
      } else {
        chosen = filtered.find(p => p.priceLabel === "Premium");
      }

      if (!chosen) chosen = filtered[0];
      if (!chosen) chosen = products[0];

      aiResultContent.innerHTML = `
        <img src="${chosen.image}" class="w-32 h-32 object-cover rounded-2xl" />
        <div class="flex-1">
          <h4 class="font-extrabold text-lg text-slate-900">${chosen.title}</h4>
          <p class="text-sm text-slate-600 mt-1">${chosen.description}</p>
          <p class="text-xs text-slate-500 mt-2">⭐ ${chosen.rating} — ${chosen.priceRange}</p>
        </div>
      `;

      aiAmazonLink.href = chosen.amazonUrl;
      aiReviewLink.href = `/producto/${chosen.id}`;

      aiStep2.classList.add("hidden");
      aiStepResult.classList.remove("hidden");
    }
  </script>

</body>
</html>

---
// src/pages/categoria/[category].astro - Plantilla interactiva con buscador en tiempo real para agrupar productos por su categoría
import '../../styles/global.css';
import { products } from '../../data/products';

export async function getStaticPaths() {
  // Extraemos las categorías únicas de la base de datos para generar las rutas estáticas
  const categories = [...new Set(products.map(p => p.category))];
  
  return categories.map((cat) => {
    const categoryProducts = products.filter(p => p.category === cat);
    return {
      params: { category: cat },
      props: { 
        categoryName: categoryProducts[0]?.categoryLabel || cat,
        categoryProducts 
      }
    };
  });
}

const { categoryName, categoryProducts } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mejores Productos de {categoryName} | ElegidosParaTi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">

  <!-- HEADER -->
  <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl group-hover:scale-110 transition-transform">💎</span>
        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-violet-600 to-emerald-500 bg-clip-text text-transparent">ElegidosParaTi</span>
      </a>
      <a href="/" class="text-sm font-semibold text-slate-600 hover:text-violet-600 transition-colors flex items-center gap-1">
        ← Volver al Inicio
      </a>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <span class="text-xs font-bold text-violet-600 uppercase tracking-widest">Catálogo Oficial</span>
        <h1 class="text-3xl font-extrabold text-slate-900 mt-2">Los mejores en: {categoryName}</h1>
        <p class="text-slate-500 mt-1">Comparados y filtrados rigurosamente por nuestro equipo técnico ({categoryProducts.length} productos).</p>
      </div>
      
      <!-- BUSCADOR EN TIEMPO REAL DE LA CATEGORÍA -->
      <div class="w-full md:max-w-md relative">
        <div class="flex items-center bg-white border border-slate-200 rounded-2xl shadow-md p-1 focus-within:border-violet-500 transition-all">
          <span class="pl-3 text-slate-400 text-lg">🔍</span>
          <input 
            id="category-search-input" 
            type="text" 
            placeholder={`Buscar en la categoría ${categoryName}...`} 
            class="w-full pl-2 pr-4 py-2.5 bg-transparent text-slate-800 placeholder-slate-400 focus:outline-none text-sm font-semibold"
          />
          <button id="clear-cat-search-btn" class="hidden text-slate-400 hover:text-slate-600 mr-2 text-xs font-bold uppercase tracking-wider">Limpiar</button>
        </div>
      </div>
    </div>

    <!-- Alerta No Coincidencias -->
    <div id="no-cat-results" class="hidden bg-white border border-slate-200 p-12 rounded-3xl text-center my-6 shadow-sm">
      <span class="text-5xl">🔍</span>
      <h3 class="font-bold text-xl text-slate-800 mt-4">No hemos encontrado coincidencias</h3>
      <p class="text-slate-500 text-sm mt-1 max-w-md mx-auto">Prueba a escribir marcas como 'Logitech', 'Razer', 'Sony' o características específicas del dispositivo.</p>
    </div>

    <!-- Lista de productos de la categoría -->
    <div id="cat-products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {categoryProducts.map((prod) => (
        <div 
          class="cat-product-card bg-white border border-slate-200 rounded-3xl overflow-hidden hover:shadow-lg transition-all flex flex-col justify-between"
          data-title={prod.title.toLowerCase()}
          data-description={prod.description.toLowerCase()}
          data-id={prod.id}
        >
          <div>
            <div class="relative">
              <img src={prod.image} alt={prod.title} class="w-full h-48 object-cover" />
              {prod.isEditorChoice && (
                <span class="absolute top-4 left-4 bg-violet-600 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-full shadow-md">
                  👑 Recomendado
                </span>
              )}
              {prod.isBestValue && (
                <span class="absolute top-4 left-4 bg-emerald-600 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-full shadow-md">
                  💰 Calidad/Precio
                </span>
              )}
            </div>
            
            <div class="p-6">
              <h3 class="font-bold text-lg text-slate-900 leading-snug line-clamp-2">{prod.title}</h3>
              <div class="flex items-center gap-1.5 text-xs text-slate-500 my-2">
                <span>⭐ {prod.rating}</span>
                <span>({prod.reviewsCount} opiniones)</span>
              </div>
              <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed">{prod.description}</p>
              
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500">Rango: {prod.priceRange} ({prod.priceLabel})</span>
              </div>
            </div>
          </div>
          
          <div class="p-6 pt-0 mt-2 flex flex-col gap-3">
            <!-- Check de Comparación -->
            <label class="flex items-center gap-2 cursor-pointer select-none bg-slate-50 hover:bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl transition-all">
              <input 
                type="checkbox" 
                class="compare-checkbox w-4 h-4 text-violet-600 border-slate-300 rounded focus:ring-violet-500" 
                data-id={prod.id} 
                data-title={prod.title}
                data-rating={prod.rating}
                data-price={prod.priceLabel}
                data-image={prod.image}
                data-pros={JSON.stringify(prod.pros)}
                data-cons={JSON.stringify(prod.cons)}
              />
              <span class="text-xs font-semibold text-slate-700">Agregar al Comparador</span>
            </label>

            <div class="flex items-center justify-between gap-2">
              <a href={`/producto/${prod.id}`} class="text-xs font-bold text-slate-700 hover:text-violet-600 transition-colors">Ver Análisis Detallado →</a>
              <a href={prod.amazonUrl} target="_blank" rel="noopener noreferrer nofollow" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold px-4 py-2 rounded-xl text-xs flex items-center gap-1 shadow">
                Comprar en Amazon 🛒
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>

  <!-- PANEL DE COMPARATIVA FLOTANTE -->
  <div id="compare-tray" class="fixed bottom-6 right-6 z-50 transform translate-y-32 opacity-0 transition-all duration-300 max-w-sm w-full bg-slate-900 text-white p-5 rounded-3xl shadow-2xl border border-slate-800">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚖️</span>
        <h4 class="font-bold text-sm">Comparador (<span id="compare-count">0</span>/3)</h4>
      </div>
      <button id="close-tray-btn" class="text-slate-400 hover:text-white text-xs font-bold uppercase">Cerrar</button>
    </div>
    <div id="compare-tray-items" class="flex items-center gap-2 mb-4 overflow-x-auto py-1">
      <!-- Elementos agregados dinámicamente -->
    </div>
    <div class="flex gap-2">
      <button id="trigger-compare-modal-btn" class="w-full text-center bg-violet-600 hover:bg-violet-700 text-white font-bold py-2.5 rounded-xl text-xs transition-all shadow-md">
        Comparar Cara a Cara ➔
      </button>
    </div>
  </div>

  <!-- MODAL DE COMPARATIVA MÁXIMA -->
  <div id="compare-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-5xl w-full max-h-[90vh] overflow-y-auto p-6 md:p-8 shadow-2xl relative">
      <button id="close-compare-modal-btn" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
      <h3 class="font-extrabold text-2xl text-slate-900 mb-6 flex items-center gap-2">
        <span>⚖️</span> Comparación Detallada de Modelos
      </h3>
      <div class="overflow-x-auto">
        <div id="compare-matrix" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Columnas dinámicas de los productos -->
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 pt-16 pb-8 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800/80 mb-6">
        <p class="text-xs text-slate-400/90 leading-relaxed">
          <strong>Aviso de Afiliación de Amazon:</strong> En calidad de Afiliado de Amazon, este portal obtiene ingresos por las compras adscritas que cumplen los requisitos aplicables. Al comprar desde nuestros enlaces, apoyas el sostenimiento de nuestras pruebas independientes sin coste adicional para ti.
        </p>
      </div>
      <div class="text-center text-xs">
        &copy; {new Date().getFullYear()} ElegidosParaTi. Todos los derechos reservados.
      </div>
    </div>
  </footer>

  <!-- SCRIPT DE FILTRADO INTERACTIVO DE CATEGORÍA Y COMPARADOR -->
  <script is:inline>
    let compareList = [];

    // Variables del DOM para el buscador local de categorías
    const searchInput = document.getElementById('category-search-input');
    const clearBtn = document.getElementById('clear-cat-search-btn');
    const productCards = document.querySelectorAll('.cat-product-card');
    const noResults = document.getElementById('no-cat-results');
    const productsGrid = document.getElementById('cat-products-grid');

    // Elementos del comparador
    const compareTray = document.getElementById('compare-tray');
    const compareCount = document.getElementById('compare-count');
    const compareTrayItems = document.getElementById('compare-tray-items');
    const closeTrayBtn = document.getElementById('close-tray-btn');
    const triggerCompareModalBtn = document.getElementById('trigger-compare-modal-btn');
    const compareModal = document.getElementById('compare-modal');
    const closeCompareModalBtn = document.getElementById('close-compare-modal-btn');
    const compareMatrix = document.getElementById('compare-matrix');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        // Mostrar / Ocultar botón de limpiar
        if (query.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        // Filtrado por coincidencia en Título o Descripción del producto
        productCards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-description') || '';

          if (title.includes(query) || desc.includes(query)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Alternar el contenedor de "No Resultados" si no hay coincidencias
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          productsGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          productsGrid.classList.remove('hidden');
        }
      });

      // Acción de limpiar el cuadro de búsqueda
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        productCards.forEach(card => card.classList.remove('hidden'));
        noResults.classList.add('hidden');
        productsGrid.classList.remove('hidden');
        searchInput.focus();
      });
    }

    // ==================== MOTOR DEL COMPARADOR POR CATEGORÍA ====================
    document.querySelectorAll('.compare-checkbox').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const target = e.target;
        const prodId = target.getAttribute('data-id');
        const prodTitle = target.getAttribute('data-title');
        const prodImage = target.getAttribute('data-image');
        const prodPrice = target.getAttribute('data-price');
        const prodRating = target.getAttribute('data-rating');
        const prodPros = JSON.parse(target.getAttribute('data-pros'));
        const prodCons = JSON.parse(target.getAttribute('data-cons'));

        if (target.checked) {
          if (compareList.length >= 3) {
            alert('Solo puedes comparar un máximo de 3 productos a la vez.');
            target.checked = false;
            return;
          }
          compareList.push({ id: prodId, title: prodTitle, image: prodImage, price: prodPrice, rating: prodRating, pros: prodPros, cons: prodCons });
        } else {
          compareList = compareList.filter(item => item.id !== prodId);
        }

        renderCompareTray();
      });
    });

    function renderCompareTray() {
      compareTrayItems.innerHTML = '';
      compareCount.textContent = compareList.length;

      if (compareList.length > 0) {
        compareTray.classList.remove('translate-y-32', 'opacity-0');
        compareTray.classList.add('translate-y-0', 'opacity-100');

        compareList.forEach(item => {
          const thumb = document.createElement('div');
          thumb.className = 'relative flex-shrink-0 w-12 h-12 bg-white rounded-xl overflow-hidden border border-slate-700';
          thumb.innerHTML = `
            <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover"/>
            <button class="absolute -top-1 -right-1 bg-rose-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-[8px] font-bold" onclick="removeCompareItem('${item.id}')">&times;</button>
          `;
          compareTrayItems.appendChild(thumb);
        });
      } else {
        compareTray.classList.add('translate-y-32', 'opacity-0');
        compareTray.classList.remove('translate-y-0', 'opacity-100');
      }
    }

    window.removeCompareItem = function(id) {
      compareList = compareList.filter(item => item.id !== id);
      const chk = document.querySelector(`.compare-checkbox[data-id="${id}"]`);
      if (chk) chk.checked = false;
      renderCompareTray();
    };

    closeTrayBtn.addEventListener('click', () => {
      compareTray.classList.add('translate-y-32', 'opacity-0');
    });

    // Abrir Modal de Comparación Cara a Cara
    triggerCompareModalBtn.addEventListener('click', () => {
      if (compareList.length < 2) {
        alert('Por favor selecciona al menos 2 productos para realizar la comparación.');
        return;
      }

      compareMatrix.innerHTML = '';
      compareList.forEach(item => {
        const col = document.createElement('div');
        col.className = 'bg-slate-50 border border-slate-200 p-5 rounded-2xl flex flex-col justify-between';
        
        let prosHtml = '';
        item.pros.forEach(pro => {
          prosHtml += `<li class="flex items-start gap-1.5 text-xs text-slate-600">✔️ ${pro}</li>`;
        });

        let consHtml = '';
        item.cons.forEach(con => {
          consHtml += `<li class="flex items-start gap-1.5 text-xs text-slate-600">❌ ${con}</li>`;
        });

        col.innerHTML = `
          <div>
            <img src="${item.image}" alt="${item.title}" class="w-full h-36 object-cover rounded-xl border border-slate-100 mb-4"/>
            <h4 class="font-bold text-base text-slate-800 mb-1 leading-snug line-clamp-2">${item.title}</h4>
            <div class="text-xs text-slate-500 mb-3">Valoración: ⭐ ${item.rating}</div>
            
            <div class="border-t border-slate-200 pt-3 mt-3">
              <span class="text-xs font-bold text-slate-400 uppercase block mb-1">Precio</span>
              <span class="text-sm font-bold text-slate-800">${item.price}</span>
            </div>

            <div class="border-t border-slate-200 pt-3 mt-3">
              <span class="text-xs font-bold text-emerald-600 uppercase block mb-2">✔️ Pros</span>
              <ul class="space-y-1.5">${prosHtml}</ul>
            </div>

            <div class="border-t border-slate-200 pt-3 mt-3">
              <span class="text-xs font-bold text-rose-600 uppercase block mb-2">❌ Contras</span>
              <ul class="space-y-1.5">${consHtml}</ul>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <a href="/producto/${item.id}" class="text-center text-xs font-bold text-violet-600 hover:underline">Ver Análisis Detallado</a>
          </div>
        `;
        compareMatrix.appendChild(col);
      });

      compareModal.classList.remove('hidden');
    });

    closeCompareModalBtn.addEventListener('click', () => {
      compareModal.classList.add('hidden');
    });
  </script>

</body>
</html>